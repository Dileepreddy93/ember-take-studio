{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Engine",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:*:*:function:ember-take-*"
    },
    {
      "Sid": "Image",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:*:*:repository/ember-take-*"
    },
    {
      "Sid": "Schedule",
      "Effect": "Allow",
      "Action": "events:*",
      "Resource": "arn:aws:events:*:*:rule/ember-take-*"
    },
    {
      "Sid": "Roles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/ember-take-*"
    },
    {
      "Sid": "RoleLogging",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::*:role/ember-take-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "Read",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "lambda:GetAccountSettings",
        "lambda:ListFunctions",
        "cloudwatch:GetMetricStatistics",
        "freetier:Get*",
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "logs:CreateLogGroup",
        "logs:DescribeLogGroups",
        "logs:PutRetentionPolicy",
        "logs:DeleteLogGroup",
        "logs:FilterLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
